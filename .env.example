# Copy this file to .env for local development (.env is gitignored).
# Matches the credentials in docker-compose.yml — run `docker compose up -d`
# then this will just work.
DATABASE_URL=postgres://eyelearn:eyelearn@localhost:5432/eyelearn

# OAuth Client ID from Google Cloud Console (must match the frontend's
# GOOGLE_OAUTH_CLIENT_ID -- it's used to verify the audience of Google ID tokens).
GOOGLE_OAUTH_CLIENT_ID=

# Which billing/providers/*_provider.py connector BillingService uses.
# Currently only 'stripe' is implemented.
PAYMENT_PROVIDER=stripe

# Stripe API keys (test mode locally -- get these from the Stripe Dashboard
# or `stripe listen` for the webhook secret; see CLAUDE.md for the local dev flow).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs, one per plan x currency combination shown on the pricing page.
STRIPE_PRICE_ID_MONTHLY_USD=
STRIPE_PRICE_ID_MONTHLY_BRL=
STRIPE_PRICE_ID_ANNUAL_USD=
STRIPE_PRICE_ID_ANNUAL_BRL=

# Origins the billing endpoints will accept as success_url/cancel_url/return_url
# targets, so a checkout/portal session can never be pointed at an attacker-supplied host.
# Also used as the CORS allow-list.
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000

# Canonical frontend URL used to build password-reset links.
FRONTEND_URL=http://localhost:3000

# Resend (https://resend.com) API key for sending password-reset emails.
# Free tier, no credit card. Without a verified sending domain in the Resend
# dashboard, emails can only be delivered to the account's own verified
# address using the default onboarding@resend.dev sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where the Help page's contact form notifies the team of a new submission.
# Leave blank to skip that notification email (the ContactMessage row and the
# submitter's confirmation email still go out).
CONTACT_NOTIFICATION_EMAIL=

# Shared secret required on every request except the Stripe webhook (see
# eyelearn/middleware.py). Generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` and put the
# same value in eyelearn-ui's EYELEARN_INTERNAL_API_KEY, and in Postman as
# the X-Internal-Api-Key header for manual testing.
INTERNAL_API_KEY=

# Object storage for flashcard media (image/audio/video), an S3-compatible bucket.
# Uses Backblaze B2's S3-compatible API (see CLAUDE.md for setup steps). Since
# B2, R2, and AWS S3 all speak the same S3 API, switching providers later only
# means changing these values -- flashcards/storage.py doesn't change.
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=

# FSRS scheduler tuning (see flashcards/services.py ReviewService). Fuzzing off
# by default for deterministic study queues/tests.
FSRS_DESIRED_RETENTION=0.9
FSRS_ENABLE_FUZZING=False
